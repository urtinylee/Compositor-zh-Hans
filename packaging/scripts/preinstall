#!/bin/sh
# Install only the independently named Chinese application on the startup volume.
set -eu
fail() { echo "Compositor 简体中文：$1" >&2; exit 1; }
[ "${3:-/}" = "/" ] || fail "仅支持安装到当前启动磁盘。"
[ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = "1" ] || fail "需要 Apple silicon Mac（M 系列芯片）。"
major=$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d . -f 1)
[ "$major" -ge 26 ] || fail "需要 macOS 26 或更高版本。"
target='/Applications/Compositor 简体中文.app'
[ ! -L "$target" ] || fail "安装位置是符号链接，请选择其他安装方式。"
if [ -e "$target" ]; then
    existing=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$target/Contents/Info.plist" 2>/dev/null || true)
    [ "$existing" = 'com.wonderassembly.compositor.zhHans' ] || fail "安装位置有其他应用，请先手动移走该文件。"
fi
if /usr/bin/pgrep -f '^/Applications/Compositor 简体中文[.]app/Contents/MacOS/Compositor($| )' >/dev/null 2>&1; then
    fail "请先退出 Compositor 简体中文，再重新安装。"
fi
exit 0
